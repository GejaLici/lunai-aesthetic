
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // By default, deny all reads and writes to all files.
    // This is a secure default. You should explicitly grant access
    // to specific paths as needed.
    // match /{allPaths=**} {
    //  allow read, write: if false;
    // }

    // Example: Allow authenticated users to upload, read, and delete their own files.
    // Assumes files are stored in a path like: /users/{userId}/<filename>
    // or /users/{userId}/profileImages/<filename>
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
      // You might want to add size restrictions or content type validation here
      // e.g., request.resource.size < 5 * 1024 * 1024 &&
      //       request.resource.contentType.matches('image/.*')
    }

    // Example: Allow public read access to files in a 'public-assets' folder.
    // Writes to this folder might be restricted to admin users (not shown here).
    // match /public-assets/{allPaths=**} {
    //   allow read: if true;
    //   // allow write: if <condition_for_admin_or_specific_role>;
    // }
  }
}
