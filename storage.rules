
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // WARNING: These rules are insecure and allow read/write access to everyone.
    // You MUST update these rules to properly secure your data before deploying to production.
    // Example: Restrict access to authenticated users for specific paths.
    // Learn more: https://firebase.google.com/docs/storage/security/start
    match /{allPaths=**} {
      allow read, write: if true; // Replace "if true" with your security logic
    }
  }
}
