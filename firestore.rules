
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default: Deny all reads and writes to all documents unless explicitly allowed
    match /{document=**} {
      allow read, write: if false;
    }

    // Example: Allow authenticated users to manage their own data in a 'users' collection
    // This allows a user to read, update, or delete their own document in the 'users' collection,
    // and allows any authenticated user to create a document in the 'users' collection.
    // match /users/{userId} {
    //   allow read, update, delete: if request.auth != null && request.auth.uid == userId;
    //   allow create: if request.auth != null;
    // }

    // Example: Allow public read access to a 'posts' collection, 
    // but only authenticated users can create, update, or delete posts.
    // match /posts/{postId} {
    //   allow read: if true;
    //   allow create, update, delete: if request.auth != null;
    // }

    // Rules for 'contactSubmissions' collection
    // This allows anyone to create (submit) a contact message.
    // Reading, updating, or deleting these submissions requires authentication.
    // IMPORTANT: For production, you might want to restrict read/update/delete to admin roles.
    match /contactSubmissions/{submissionId} {
      allow create: if true; // Allows anyone to submit the contact form
      allow read: if request.auth != null; 
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
  }
}
