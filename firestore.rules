
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read and write access for blog posts
    match /blogPosts/{postId} {
      allow read, write: if true;
    }

    // Allow anyone to create contact form submissions, and allow public read for the admin panel.
    match /contactSubmissions/{submissionId} {
      allow create: if true;
      allow read: if true;
    }

    // Allow read/write for Genkit flow and trace data
    match /genkit-flows/{flowId} {
      allow read, write: if true;
    }
    match /genkit-traces/{traceId} {
      allow read, write: if true;
    }
  }
}
