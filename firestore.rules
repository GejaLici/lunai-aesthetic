
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // WARNING: These rules are insecure and allow read/write access to everyone.
    // You MUST update these rules to properly secure your data before deploying to production.
    // Example: Restrict access to authenticated users: allow read, write: if request.auth != null;
    // Learn more: https://firebase.google.com/docs/firestore/security/get-started
    match /{document=**} {
      allow read, write: if true; // Replace "if true" with your security logic
    }
  }
}
