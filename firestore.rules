rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read access to blog posts for everyone
    match /blogPosts/{postId} {
      allow read, write: if true;
    }

    // Allow create access for contact form submissions, and read for authenticated users
    match /contactSubmissions/{submissionId} {
      allow create: if true;
      allow read: if request.auth != null;
    }

    // Allow read/write access for Genkit flow and trace data
    match /genkit-flows/{flowId} {
      allow read, write: if true;
    }
    match /genkit-traces/{traceId} {
      allow read, write: if true;
    }
  }
}
    