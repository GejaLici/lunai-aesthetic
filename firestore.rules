
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read/write access to the blog posts collection for the admin panel
    match /blogPosts/{postId} {
      allow read, write: if true;
    }

    // Allow public write access for the contact form submissions
    match /contactSubmissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if false; // Only allow creation
    }

    // Genkit requires access to its own collections for storing flow states and traces.
    // Allow public read and write access to these collections.
    match /genkit-flows/{flowId} {
        allow read, write: if true;
    }
    match /genkit-traces/{traceId} {
        allow read, write: if true;
    }
  }
}
