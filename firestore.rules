
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Blog posts can only be read or written by authenticated users.
    match /blogPosts/{postId} {
      allow read, write: if request.auth != null;
    }

    // Anyone can create a contact submission.
    // Only authenticated users can read, update, or delete them.
    match /contactSubmissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Allow read/write for Genkit flow and trace data
    match /genkit-flows/{flowId} {
      allow read, write: if true;
    }
    match /genkit-traces/{traceId} {
      allow read, write: if true;
    }
  }
}
