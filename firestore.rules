rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default: Deny all reads and writes if no other rules match.
    match /{document=**} {
      allow read, write: if false;
    }

    // Example: Allow authenticated users to read and write their own data
    // in a 'users' collection where the document ID is the user's UID.
    // match /users/{userId} {
    //   allow read, update, delete: if request.auth != null && request.auth.uid == userId;
    //   allow create: if request.auth != null;
    // }

    // Example: Allow public read access to a 'posts' collection,
    // but only authenticated users can create, update, or delete posts.
    // match /posts/{postId} {
    //   allow read: if true;
    //   allow create, update, delete: if request.auth != null;
    // }

    // For the contact form submissions
    // This rule allows anyone to create (write) a document in contactSubmissions.
    // Reading, updating, or deleting requires authentication (for admin purposes, for example).
    // Adjust as per your security needs, especially for read/update/delete.
    match /contactSubmissions/{submissionId} {
      allow create: if true; // Allows anyone to submit the form
      allow read, update, delete: if request.auth != null; // Only authenticated users can manage submissions
    }
  }
}
