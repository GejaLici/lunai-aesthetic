[debug] [2025-06-20T10:59:32.304Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-app:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Default: Deny all reads and writes if no other rules match.\n    match /{document=**} {\n      allow read, write: if false;\n    }\n\n    // Example: Allow authenticated users to read and write their own data\n    // in a 'users' collection where the document ID is the user's UID.\n    // match /users/{userId} {\n    //   allow read, update, delete: if request.auth != null && request.auth.uid == userId;\n    //   allow create: if request.auth != null;\n    // }\n\n    // Example: Allow public read access to a 'posts' collection,\n    // but only authenticated users can create, update, or delete posts.\n    // match /posts/{postId} {\n    //   allow read: if true;\n    //   allow create, update, delete: if request.auth != null;\n    // }\n\n    // For the contact form submissions\n    // This rule allows anyone to create (write) a document in contactSubmissions.\n    // Reading, updating, or deleting requires authentication (for admin purposes, for example).\n    // Adjust as per your security needs, especially for read/update/delete.\n    match /contactSubmissions/{submissionId} {\n      allow create: if true; // Allows anyone to submit the form\n      allow read, update, delete: if request.auth != null; // Only authenticated users can manage submissions\n    }\n  }\n}\n"}]}}
