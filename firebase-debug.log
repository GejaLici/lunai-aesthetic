[debug] [2025-06-20T11:06:43.570Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-app:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"\nrules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Default: Deny all reads and writes to all documents unless explicitly allowed\n    match /{document=**} {\n      allow read, write: if false;\n    }\n\n    // Example: Allow authenticated users to manage their own data in a 'users' collection\n    // This allows a user to read, update, or delete their own document in the 'users' collection,\n    // and allows any authenticated user to create a document in the 'users' collection.\n    // match /users/{userId} {\n    //   allow read, update, delete: if request.auth != null && request.auth.uid == userId;\n    //   allow create: if request.auth != null;\n    // }\n\n    // Example: Allow public read access to a 'posts' collection, \n    // but only authenticated users can create, update, or delete posts.\n    // match /posts/{postId} {\n    //   allow read: if true;\n    //   allow create, update, delete: if request.auth != null;\n    // }\n\n    // Rules for 'contactSubmissions' collection\n    // This allows anyone to create (submit) a contact message.\n    // Reading, updating, or deleting these submissions requires authentication.\n    // IMPORTANT: For production, you might want to restrict read/update/delete to admin roles.\n    match /contactSubmissions/{submissionId} {\n      allow create: if true; // Allows anyone to submit the contact form\n      allow read: if request.auth != null; \n      allow update: if request.auth != null;\n      allow delete: if request.auth != null;\n    }\n  }\n}\n"}]}}
