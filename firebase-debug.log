[debug] [2025-06-20T10:08:46.346Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-app:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"\nrules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    // By default, deny all reads and writes to all documents.\n    // This is a secure default. You should explicitly grant access\n    // to specific collections/documents as needed.\n    match /{document=**} {\n      allow read, write: if false;\n    }\n\n    // Example: Allow authenticated users to read and write their own user document.\n    // Assumes you have a 'users' collection where each document ID is the user's UID.\n    // match /users/{userId} {\n    //   allow read, update, delete: if request.auth != null && request.auth.uid == userId;\n    //   allow create: if request.auth != null; // Allows any authenticated user to create their own user document\n    // }\n\n    // Example: Allow public read access to a 'posts' collection,\n    // but only authenticated users can create, update, or delete posts.\n    // match /posts/{postId} {\n    //   allow read: if true;\n    //   allow create, update, delete: if request.auth != null;\n    //   // For more fine-grained control, you might check if the user is the author:\n    //   // allow update, delete: if request.auth != null && request.auth.uid == resource.data.authorId;\n    // }\n\n    // Example: Allow authenticated users to create documents in a 'submissions' collection.\n    // Further rules would be needed for read/update/delete, e.g., only by the creator or an admin.\n    // match /submissions/{submissionId} {\n    //   allow create: if request.auth != null;\n    //   // Example: allow creator to read/update/delete their own submission\n    //   // allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;\n    // }\n  }\n}\n"}]}}
